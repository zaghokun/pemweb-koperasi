# Contoh saja: ganti CHANGE_ME secara lokal, jangan commit kredensial asli.
# Berkas .env tidak dimuat otomatis oleh Go.
APP_ADDR=127.0.0.1:8080
COOKIE_SECURE=false

# Akun aplikasi, bukan akun administrator atau migration.
DATABASE_DSN="koperasi_app:CHANGE_ME@tcp(127.0.0.1:3306)/koperasi?parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27&charset=utf8mb4"

# Hanya untuk test: database ini wajib terpisah, kosong, dan namanya berakhiran _test.
# Test migration membutuhkan hak DDL pada database ini, bukan pada database aplikasi.
TEST_DATABASE_DSN="koperasi_test:CHANGE_ME@tcp(127.0.0.1:3306)/koperasi_test?parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27&charset=utf8mb4"
